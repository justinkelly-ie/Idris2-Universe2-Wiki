          Geometry.Emergent_Pillars_of_Physics,
          Geometry.Hadronic_Color_Confinement,
          Geometry.Archimedes_Function_and_Quadrea,
          Geometry.Discrete_Exterior_Calculus_and_Gauge,
          Evolution.Pre_Geometric_Genesis,
          Evolution.Dark_Matter_Law_Storage,
          Evolution.Non_Hardcoded_Cosmic_State,
